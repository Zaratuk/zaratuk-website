---
import BaseLayout from '@layouts/BaseLayout.astro';
import ProductVisualPreview from '@components/ProductVisualPreview.astro';
import products from '@data/products.json';

type Product = (typeof products)[number] & {
  repositoryUrl?: string;
};

export function getStaticPaths() {
  return products
    .filter((product) => product.status?.toLowerCase() !== 'coming soon' && product.slug !== 'capacity-planner')
    .map((product) => ({
      params: { slug: product.slug },
      props: { product }
    }));
}

const { product } = Astro.props as { product: Product };
const features = product.features.length
  ? product.features
  : [
      {
        title: product.name,
        does: product.description,
        matters: 'Keeps the workflow visible inside Power BI instead of sending analysts to disconnected tools.'
      }
    ];
const fieldRoles = product.fieldRoles ?? [];
const formattingControls = product.formattingControls ?? [];
const securityScan = product.securityScan;
const showFieldRoles = Boolean(product.showFieldRoles && fieldRoles.length);
const downloadLabel = product.downloadLabel ?? 'Download pbiviz';
const packageLabel = product.packageLabel ?? 'Get the visual';
const inputSectionLabel = product.inputSectionLabel ?? 'Field buckets';
const showScoreFormula = Boolean(product.scoreFormula);
const versionLabel = product.status?.match(/v\d+(?:\.\d+){1,3}/i)?.[0] ?? product.status;
const isFreemium = product.pricing?.toLowerCase().includes('freemium');
const freeItems = features.slice(0, 4).map((feature) => feature.title);
const advancedItems = (formattingControls.length ? formattingControls : features.slice(3).map((feature) => feature.title))
  .slice(0, 4)
  .map((item) => item.replace(/\.$/, ''));
const secondaryTierTitle = isFreemium ? 'Premium' : 'Advanced';
const tierSectionTitle = isFreemium ? 'Free vs Premium' : 'Included Capabilities';
const heroLead = product.whatItDoesTitle ?? product.shortDescription ?? product.description;
const heroBody = product.description;
const footerLinks = [
  { href: product.documentationUrl, label: 'Docs' },
  product.appSourceUrl ? { href: product.appSourceUrl, label: 'AppSource' } : undefined,
  product.repositoryUrl ? { href: product.repositoryUrl, label: 'GitHub' } : undefined,
  { href: '/privacy/', label: 'Privacy policy' }
].filter(Boolean) as Array<{ href: string; label: string }>;

const productStructuredData = {
  '@context': 'https://schema.org',
  '@type': product.tag?.toLowerCase().includes('connector') ? 'SoftwareApplication' : 'Product',
  name: product.fullName,
  description: product.description,
  applicationCategory: product.tag?.toLowerCase().includes('connector') ? 'BusinessApplication' : undefined,
  operatingSystem: 'Microsoft Power BI Desktop',
  softwareHelp: new URL(product.documentationUrl, Astro.site).toString(),
  downloadUrl: new URL(product.downloadUrl, Astro.site).toString(),
  codeRepository: product.repositoryUrl,
  offers: {
    '@type': 'Offer',
    price: product.pricing?.toLowerCase() === 'free' ? '0' : undefined,
    priceCurrency: 'USD',
    availability: 'https://schema.org/InStock',
    url: new URL(`/products/${product.slug}/`, Astro.site).toString()
  },
  provider: {
    '@type': 'Organization',
    name: 'Zaratük Consulting',
    url: Astro.site?.toString()
  },
  keywords: [
    product.name,
    product.tag,
    product.category,
    'Power BI custom connector',
    'Power BI custom visual',
    securityScan?.provider,
    securityScan ? '0 security issues' : undefined
  ].filter(Boolean).join(', ')
};
---

<BaseLayout
  title={`${product.fullName} | Zaratük Consulting`}
  description={product.description}
  structuredData={productStructuredData}
>
  <section class="bg-[#f5f5f7]">
    <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 sm:py-20 lg:px-8">
      <div class="flex flex-wrap gap-2">
        <span class="rounded-full border border-black/10 bg-white px-3 py-1.5 text-sm font-semibold text-slate-600">{product.tag}</span>
        <span class="rounded-full border border-black/10 bg-white px-3 py-1.5 text-sm font-semibold text-forest-700">{product.category}</span>
        {product.pricing && <span class="rounded-full border border-forest-300 bg-[#e7f0da] px-3 py-1.5 text-sm font-semibold text-forest-700">{product.pricing}</span>}
        <span class="rounded-full border border-black/10 bg-white px-3 py-1.5 text-sm font-semibold text-slate-500">{versionLabel}</span>
      </div>

      <div class="mt-7 grid gap-10 border-t border-black/10 pt-8 lg:grid-cols-[minmax(0,1.12fr)_minmax(22rem,0.62fr)] lg:items-start">
        <div>
          <h1 class="max-w-4xl text-5xl font-semibold leading-[1.03] tracking-normal text-[#1d1d1f] sm:text-6xl lg:text-7xl">
            {product.fullName}
          </h1>
          <p class="mt-5 max-w-3xl text-xl font-semibold leading-8 text-slate-700">{heroLead}</p>
          <p class="mt-4 max-w-3xl text-base leading-7 text-slate-600">{heroBody}</p>

          <div class="mt-8 flex flex-wrap gap-3">
            <a class="inline-flex h-12 items-center justify-center gap-3 rounded-lg border border-black/10 bg-white px-5 text-sm font-semibold text-[#1d1d1f] shadow-[0_10px_30px_rgba(0,0,0,0.04)] transition hover:border-forest-700" href={product.downloadUrl} download>
              <span class="h-3 w-3 border-2 border-current"></span>
              {downloadLabel}
            </a>
            {product.sampleDataUrl && (
              <a class="inline-flex h-12 items-center justify-center gap-3 rounded-lg border border-black/10 bg-white px-5 text-sm font-semibold text-[#1d1d1f] shadow-[0_10px_30px_rgba(0,0,0,0.04)] transition hover:border-forest-700" href={product.sampleDataUrl} download>
                <span class="h-3 w-3 border-2 border-current"></span>
                Sample data
              </a>
            )}
            {product.repositoryUrl ? (
              <a class="inline-flex h-12 items-center justify-center gap-3 rounded-lg border border-black/10 bg-white px-5 text-sm font-semibold text-[#1d1d1f] shadow-[0_10px_30px_rgba(0,0,0,0.04)] transition hover:border-forest-700" href={product.repositoryUrl}>
                <span class="h-3 w-3 border-2 border-current"></span>
                GitHub
              </a>
            ) : (
              <a class="inline-flex h-12 items-center justify-center gap-3 rounded-lg border border-black/10 bg-white px-5 text-sm font-semibold text-[#1d1d1f] shadow-[0_10px_30px_rgba(0,0,0,0.04)] transition hover:border-forest-700" href={product.documentationUrl}>
                <span class="h-3 w-3 border-2 border-current"></span>
                Docs
              </a>
            )}
          </div>
          <p class="mt-4 hidden text-sm font-semibold text-slate-500" data-download-count-wrapper>
            <span data-download-count={product.slug}>0 downloads</span>
          </p>
        </div>

        <ProductVisualPreview product={product} />
      </div>
    </div>
  </section>

  <section class="section-rule bg-[#f5f5f7] py-14">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-slate-500">Features</p>
      <div class="mt-5 grid gap-4 md:grid-cols-2">
        {features.map((feature) => (
          <article class="grid gap-4 rounded-lg border border-black/10 bg-white p-5 shadow-[0_10px_30px_rgba(0,0,0,0.04)] sm:grid-cols-[3rem_1fr]">
            <span class="grid h-12 w-12 place-items-center rounded-lg bg-[#e7f0da]" aria-hidden="true">
              <span class="h-4 w-4 border-2 border-forest-700"></span>
            </span>
            <div>
              <h2 class="text-lg font-semibold tracking-normal text-[#1d1d1f]">{feature.title}</h2>
              <p class="mt-2 text-sm font-medium leading-6 text-slate-600">{feature.does}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-rule bg-[#f5f5f7] py-10">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-slate-500">{tierSectionTitle}</p>
      <div class="mt-5 grid gap-4 md:grid-cols-2">
        <article class="rounded-lg border border-black/10 bg-white p-6">
          <h2 class="text-lg font-semibold text-[#1d1d1f]">Free</h2>
          <ul class="mt-5 grid gap-3">
            {freeItems.map((item) => (
              <li class="grid grid-cols-[1.25rem_1fr] items-start gap-3 text-sm font-semibold leading-6 text-slate-700">
                <span class="mt-1 h-3.5 w-3.5 border-2 border-forest-700" aria-hidden="true"></span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </article>
        <article class={`rounded-lg border bg-white p-6 ${isFreemium ? 'border-forest-400 shadow-[0_0_0_1px_rgba(107,174,110,0.35)]' : 'border-black/10'}`}>
          <h2 class="text-lg font-semibold text-forest-700">{secondaryTierTitle}</h2>
          <ul class="mt-5 grid gap-3">
            {advancedItems.map((item) => (
              <li class="grid grid-cols-[1.25rem_1fr] items-start gap-3 text-sm font-semibold leading-6 text-slate-700">
                <span class="mt-1 h-3.5 w-3.5 border-2 border-amber-600" aria-hidden="true"></span>
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </article>
      </div>
    </div>
  </section>

  {showFieldRoles && (
    <section id="how-to-use" class="section-rule bg-[#f5f5f7] py-10">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <div class="flex flex-wrap items-end justify-between gap-4">
          <div>
            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-slate-500">{inputSectionLabel}</p>
            {showScoreFormula && (
              <p class="mt-3 text-sm leading-6 text-slate-600">
                Score formula: <span class="font-semibold text-forest-950">{product.scoreFormula}</span>
              </p>
            )}
          </div>
          <p class="max-w-xl text-sm font-medium leading-6 text-slate-600">{product.fieldRolesTitle ?? 'Purpose-built inputs.'}</p>
        </div>
        <div class="mt-5 grid gap-3">
          {fieldRoles.map((role) => (
            <article class="grid gap-3 rounded-lg border border-black/10 bg-white px-5 py-4 shadow-[0_8px_24px_rgba(0,0,0,0.03)] md:grid-cols-[13rem_9rem_1fr] md:items-center">
              <h2 class="text-base font-semibold text-[#1d1d1f]">{role.name}</h2>
              <span class="w-max rounded-full border border-black/10 bg-[#e7f0da] px-3 py-1 text-xs font-semibold text-forest-700">{role.limit}</span>
              <p class="text-sm font-medium leading-6 text-slate-600">{role.description}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  {securityScan && (
    <section class="section-rule bg-[#f5f5f7] py-10">
      <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-slate-500">Security Signal</p>
        <div class="mt-5 rounded-lg border border-black/10 bg-white p-6 shadow-[0_10px_30px_rgba(0,0,0,0.04)]">
          <div class="flex flex-wrap items-center justify-between gap-4">
            <div class="flex items-center gap-4">
              <img class="h-5 w-auto" src="/products/aikido-logo-full-dark.svg" alt="Aikido logo" loading="lazy" />
              <div>
                <h2 class="text-lg font-semibold text-[#1d1d1f]">{securityScan.provider}</h2>
                <p class="mt-1 text-sm leading-6 text-slate-600">{securityScan.summary}</p>
              </div>
            </div>
            <span class="rounded-full bg-emerald-50 px-3 py-1.5 text-sm font-semibold text-forest-700">0 issues</span>
          </div>
          <p class="mt-4 text-xs leading-5 text-slate-500">{securityScan.note}</p>
        </div>
      </div>
    </section>
  )}

  <section class="section-rule bg-[#f5f5f7] py-10">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-slate-500">Use cases</p>
      <div class="mt-5 flex flex-wrap gap-3">
        {product.useCases.map((useCase) => (
          <span class="inline-flex items-center gap-3 rounded-full border border-black/10 bg-white px-5 py-3 text-sm font-semibold text-slate-700">
            <span class="h-3 w-3 border-2 border-current" aria-hidden="true"></span>
            {useCase}
          </span>
        ))}
      </div>
    </div>
  </section>

  <section id="appsource" class="section-rule bg-[#f5f5f7] py-10">
    <div class="mx-auto flex max-w-7xl flex-col gap-5 px-4 sm:px-6 md:flex-row md:items-center md:justify-between lg:px-8">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-slate-500">{packageLabel}</p>
        <h2 class="mt-2 text-2xl font-semibold tracking-normal text-[#1d1d1f]">{product.ctaTitle ?? 'Get the product.'}</h2>
      </div>
      <div class="flex flex-wrap gap-x-8 gap-y-3">
        {footerLinks.map((link) => (
          <a class="inline-flex items-center gap-2 text-sm font-semibold text-slate-600 transition hover:text-forest-950" href={link.href}>
            {link.label}
            <span class="h-2.5 w-2.5 border-2 border-current" aria-hidden="true"></span>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
