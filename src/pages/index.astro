---
import Icon from '@components/Icon.astro';
import BaseLayout from '@layouts/BaseLayout.astro';

const services = [
  {
    icon: 'products',
    title: 'Custom Power BI visuals',
    body: 'Purpose-built pbiviz components with the controls, calculations, and interface your workflow needs.'
  },
  {
    icon: 'analytics',
    title: 'Capacity planning tools',
    body: 'Scenario models for demand, FTE, productivity, utilization, gap, and cost impact.'
  },
  {
    icon: 'monitoring',
    title: 'Executive decision views',
    body: 'Compact operational dashboards that make bottlenecks and tradeoffs easier to explain.'
  }
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  name: 'Zaratuk',
  description: 'Custom Microsoft Power BI visual development for operational decision-making.',
  areaServed: 'Remote',
  email: 'info@zaratuk.ca',
  serviceType: [
    'Power BI custom visual development',
    'Workforce capacity planning',
    'Scenario modelling'
  ]
};
---

<BaseLayout
  title="Custom Power BI Visuals for Operational Decision-Making | Zaratuk"
  description="Zaratuk builds custom Microsoft Power BI visuals for workforce planning, capacity modelling, scenario analysis, and executive operational reporting."
  structuredData={structuredData}
>
  <section class="bg-[#d9e7ee] px-4 py-6 sm:px-6 sm:py-8 lg:px-8 lg:py-10">
    <div class="mx-auto max-w-7xl overflow-hidden rounded-[1.65rem] border border-white/70 bg-[#fbfbfd] shadow-[0_28px_90px_rgba(15,45,31,0.12)]">
      <div class="flex items-center justify-between gap-4 px-6 py-4 sm:px-8 lg:px-12">
        <div class="inline-flex items-center gap-3 text-forest-950">
          <img class="h-9 w-9" src="/brand/scatter-z-mark.png" alt="" loading="eager" decoding="async" />
          <div class="leading-none">
            <p class="text-sm font-semibold tracking-normal">Zaratuk</p>
            <p class="mt-1 text-[0.58rem] font-semibold uppercase tracking-[0.28em] text-forest-700">Power BI Studio</p>
          </div>
        </div>
      </div>

      <div class="relative px-6 pb-6 sm:px-8 lg:min-h-[44rem] lg:px-12 lg:pb-10">
        <div class="relative z-10 max-w-4xl pt-8 sm:pt-10 lg:pt-12">
          <h1 class="fade-up max-w-[38rem] text-[3.55rem] font-semibold uppercase leading-[0.96] tracking-normal text-[#1d1d1f] sm:text-[5rem] lg:text-[6.25rem] xl:text-[7rem]">
            Power BI
            <span class="block font-normal normal-case italic text-forest-950">decisions</span>
          </h1>
        </div>

        <div class="relative z-20 mt-8 rounded-[1.35rem] bg-[#e9e7fb] p-6 sm:p-8 lg:absolute lg:bottom-10 lg:left-12 lg:right-12 lg:mt-0 lg:min-h-[17rem] lg:pr-[34rem] xl:pr-[38rem]">
          <p class="fade-up max-w-2xl text-lg leading-8 text-[#1d1d1f] [animation-delay:180ms]">
            Zaratuk builds tailored Power BI visuals for capacity planning, scenario modelling, workforce analytics, and executive reporting when standard charts are not enough.
          </p>
          <div class="fade-up mt-6 flex flex-col gap-3 [animation-delay:270ms] sm:flex-row">
            <a class="cta-button inline-flex h-12 items-center justify-center gap-2 rounded-full bg-forest-950 px-6 text-sm font-semibold text-white shadow-[0_16px_40px_rgba(15,45,31,0.18)] transition" href="mailto:info@zaratuk.ca?subject=Custom%20Power%20BI%20visual%20consultation">
              <Icon name="send" class="h-4 w-4" />
              Start a project
            </a>
            <a class="cta-button inline-flex h-12 items-center justify-center gap-2 rounded-full border border-forest-950/20 bg-white/70 px-6 text-sm font-semibold text-forest-950 transition hover:bg-white" href="#offer">
              <Icon name="build" class="h-4 w-4" />
              See what we build
            </a>
          </div>
          <dl class="fade-up mt-8 grid max-w-2xl gap-4 [animation-delay:360ms] sm:grid-cols-3">
            <div>
              <dt class="inline-flex items-center gap-1.5 text-xs font-semibold uppercase tracking-[0.14em] text-slate-500">
                <Icon name="code" class="h-3.5 w-3.5" />
                Stack
              </dt>
              <dd class="mt-1 text-sm font-semibold text-forest-950">TypeScript + React</dd>
            </div>
            <div>
              <dt class="inline-flex items-center gap-1.5 text-xs font-semibold uppercase tracking-[0.14em] text-slate-500">
                <Icon name="privacy" class="h-3.5 w-3.5" />
                Runtime
              </dt>
              <dd class="mt-1 text-sm font-semibold text-forest-950">Inside Power BI</dd>
            </div>
            <div>
              <dt class="inline-flex items-center gap-1.5 text-xs font-semibold uppercase tracking-[0.14em] text-slate-500">
                <Icon name="target" class="h-3.5 w-3.5" />
                Focus
              </dt>
              <dd class="mt-1 text-sm font-semibold text-forest-950">Operations</dd>
            </div>
          </dl>
        </div>

        <div class="hero-laptop fade-up relative z-30 mx-auto mt-8 w-full max-w-[34rem] [animation-delay:210ms] lg:absolute lg:bottom-8 lg:right-6 lg:mt-0 xl:right-12">
          <div class="laptop-lid">
            <div class="laptop-screen">
              <div class="flex items-center justify-between border-b border-black/10 px-4 py-3">
                <div>
                  <p class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.18em] text-slate-500">
                    <Icon name="products" class="h-4 w-4 text-forest-700" />
                    Power BI
                  </p>
                  <p class="mt-1 text-sm font-semibold text-[#1d1d1f]">Capacity Planner</p>
                </div>
                <div class="flex items-end gap-1.5" aria-hidden="true">
                  <span class="h-3 w-2 rounded-sm bg-powerbi-500"></span>
                  <span class="h-5 w-2 rounded-sm bg-powerbi-500"></span>
                  <span class="h-7 w-2 rounded-sm bg-powerbi-500"></span>
                </div>
              </div>
              <div class="grid gap-3 p-4">
                <div class="grid grid-cols-3 gap-2">
                  {[
                    ['Demand', '7.9K'],
                    ['Capacity', '8.3K'],
                    ['Gap', '+350']
                  ].map(([label, value]) => (
                    <div class="rounded-lg border border-black/10 bg-[#fbfcfd] p-3">
                      <p class="text-[0.6rem] font-semibold uppercase tracking-[0.12em] text-slate-500">{label}</p>
                      <p class="mt-1 text-lg font-semibold text-[#1d1d1f]">{value}</p>
                    </div>
                  ))}
                </div>
                <div class="rounded-lg border border-black/10 bg-white p-3">
                  {[
                    ['Officer', '88%', 'w-[88%]', 'bg-forest-700'],
                    ['Supervisor', '74%', 'w-[74%]', 'bg-forest-400'],
                    ['Agent', '96%', 'w-[96%]', 'bg-powerbi-500']
                  ].map(([role, value, width, color]) => (
                    <div class="mb-3 last:mb-0">
                      <div class="mb-1 flex items-center justify-between text-xs font-semibold">
                        <span class="text-slate-600">{role}</span>
                        <span class="text-[#1d1d1f]">{value}</span>
                      </div>
                      <div class="h-2 overflow-hidden rounded-full bg-slate-100">
                        <div class={`capacity-fill h-full rounded-full ${width} ${color}`}></div>
                      </div>
                    </div>
                  ))}
                </div>
                <div class="grid grid-cols-[1fr_0.7fr] gap-3">
                  <div class="rounded-lg border border-black/10 bg-[#fbfcfd] p-3">
                    <p class="text-xs font-semibold text-slate-500">Scenario FTE</p>
                    <p class="mt-2 text-2xl font-semibold text-forest-950">+3.0</p>
                  </div>
                  <div class="rounded-lg border border-black/10 bg-[#fbfcfd] p-3">
                    <p class="text-xs font-semibold text-slate-500">Utilization</p>
                    <p class="mt-2 text-2xl font-semibold text-forest-950">92%</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class="laptop-base" aria-hidden="true"></div>
        </div>
      </div>
    </div>
  </section>

  <section id="offer" class="section-rule bg-white py-12 sm:py-14">
    <div class="mx-auto grid max-w-7xl gap-8 px-4 sm:px-6 lg:grid-cols-[0.8fr_1.2fr] lg:items-start lg:px-8">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-forest-700">What we build</p>
        <h2 class="mt-3 text-3xl font-semibold tracking-normal text-[#1d1d1f] sm:text-4xl">
          Focused visuals for business decisions that standard charts cannot quite handle.
        </h2>
      </div>
      <div class="grid gap-4 sm:grid-cols-3">
        {services.map((service, index) => (
          <article class="service-card fade-sequence rounded-xl border border-black/10 bg-[#fbfcfd] p-5 shadow-line" style={`--sequence-delay: ${index * 90}ms`}>
            <span class="grid h-11 w-11 place-items-center rounded-lg bg-[#e7f0da] text-forest-700" aria-hidden="true">
              <Icon name={service.icon} class="h-5 w-5" />
            </span>
            <h3 class="mt-5 text-lg font-semibold text-forest-950">{service.title}</h3>
            <p class="mt-3 text-sm leading-6 text-slate-600">{service.body}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="section-rule bg-forest-950 py-12 text-white sm:py-14">
    <div class="mx-auto flex max-w-7xl flex-col gap-6 px-4 sm:px-6 lg:flex-row lg:items-center lg:justify-between lg:px-8">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.18em] text-powerbi-500">Start a conversation</p>
        <h2 class="mt-3 max-w-3xl text-3xl font-semibold tracking-normal">
          Have a Power BI workflow that deserves its own visual?
        </h2>
        <p class="mt-3 max-w-2xl text-sm leading-6 text-white/70">
          Send the workflow, fields, and decision you want to support. A short note is enough to begin.
        </p>
      </div>
      <a class="cta-button inline-flex h-12 items-center justify-center gap-2 rounded-lg bg-powerbi-500 px-6 text-sm font-semibold text-forest-950 transition" href="mailto:info@zaratuk.ca?subject=Custom%20Power%20BI%20visual%20consultation">
        <Icon name="contact" class="h-4 w-4" />
        Email info@zaratuk.ca
      </a>
    </div>
  </section>
</BaseLayout>
