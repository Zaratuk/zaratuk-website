---
import Icon from './Icon.astro';

const { product } = Astro.props;
const slug = String(product.slug);

type MetricTone = 'good' | 'warn' | 'bad';
type PreviewMetric = {
  label: string;
  value: string;
  note: string;
  tone?: MetricTone;
};
type PreviewConfig = {
  eyebrow: string;
  metrics: PreviewMetric[];
};

const metricSets: Record<string, PreviewConfig> = {
  'routeops-visual-powerbi': {
    eyebrow: 'Live preview',
    metrics: [
      { label: 'Entities', value: '128', note: 'vehicles, stops, assets' },
      { label: 'On route', value: '91%', note: 'active', tone: 'good' },
      { label: 'Delayed', value: '9', note: 'window risk', tone: 'warn' },
      { label: 'Offline', value: '4', note: 'stale GPS', tone: 'bad' }
    ]
  },
  'product-margin-what-if-cards': {
    eyebrow: 'Live scenario',
    metrics: [
      { label: 'Unit cost', value: '$27', note: 'base $34' },
      { label: 'Margin %', value: '64%', note: 'base 41%', tone: 'good' },
      { label: 'Impact', value: '+98%', note: 'vs baseline', tone: 'good' },
      { label: 'Inputs', value: '3', note: 'active sliders' }
    ]
  },
  'data-health-panel': {
    eyebrow: 'Live preview',
    metrics: [
      { label: 'Health score', value: '71', note: 'needs attention', tone: 'warn' },
      { label: 'Completeness', value: '82', note: 'fields checked', tone: 'good' },
      { label: 'Freshness', value: '30', note: 'stale signal', tone: 'bad' },
      { label: 'Validity', value: '94', note: 'categories', tone: 'good' }
    ]
  },
  'pipeline-health-monitor': {
    eyebrow: 'Live preview',
    metrics: [
      { label: 'Pipelines', value: '12', note: 'monitored' },
      { label: 'Healthy', value: '9', note: 'latest run ok', tone: 'good' },
      { label: 'Late', value: '2', note: 'SLA risk', tone: 'warn' },
      { label: 'Failed', value: '1', note: 'needs review', tone: 'bad' }
    ]
  },
  'llm-usage-monitor': {
    eyebrow: 'Connector preview',
    metrics: [
      { label: 'Requests', value: '42k', note: 'daily rows' },
      { label: 'Cost', value: '$318', note: 'tracked', tone: 'warn' },
      { label: 'Tokens', value: '18.2M', note: 'input/output' },
      { label: 'Models', value: '6', note: 'active' }
    ]
  }
};

const preview = metricSets[slug] ?? {
  eyebrow: 'Live preview',
  metrics: [
    { label: 'Signals', value: '12', note: 'ready' },
    { label: 'Healthy', value: '91%', note: 'active', tone: 'good' },
    { label: 'Warnings', value: '3', note: 'review', tone: 'warn' },
    { label: 'Errors', value: '0', note: 'clear', tone: 'good' }
  ]
};

const valueToneClass: Record<MetricTone, string> = {
  good: 'text-forest-700',
  warn: 'text-amber-700',
  bad: 'text-red-700'
};
const metricValueClass = (tone?: MetricTone) => tone ? valueToneClass[tone] : 'text-[#1d1d1f]';
---

<aside class="rounded-lg border border-black/10 bg-white p-6 shadow-[0_18px_60px_rgba(0,0,0,0.06)]">
  <div class="flex items-center justify-between gap-4">
    <div>
      <p class="inline-flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.16em] text-slate-500">
        <Icon name="monitoring" class="h-4 w-4 text-forest-700" />
        {preview.eyebrow}
      </p>
      <p class="mt-1 text-xs font-medium text-slate-500">{product.name}</p>
    </div>
    <img class="h-10 w-10 rounded-xl shadow-[0_8px_24px_rgba(0,0,0,0.10)]" src={product.iconUrl} alt={`${product.name} icon`} loading="eager" />
  </div>

  <div class="mt-5 grid grid-cols-2 gap-x-6 gap-y-5">
    {preview.metrics.map((metric) => (
      <div>
        <p class="text-xs font-semibold uppercase tracking-[0.12em] text-slate-500">{metric.label}</p>
        <p class={`mt-1 text-3xl font-semibold tracking-normal ${metricValueClass(metric.tone)}`}>{metric.value}</p>
        <p class="mt-1 text-sm leading-5 text-slate-600">{metric.note}</p>
      </div>
    ))}
  </div>

  {slug === 'product-margin-what-if-cards' ? (
    <div class="mt-8 rounded-lg bg-[#eef2ec] p-5">
      <div class="flex h-3 overflow-hidden rounded-full bg-white">
        <span class="w-[14%] bg-blue-500"></span>
        <span class="w-[22%] bg-forest-600"></span>
        <span class="w-[18%] bg-amber-700"></span>
        <span class="w-[46%] bg-teal-200"></span>
      </div>
      <div class="mt-5 grid gap-3">
        <div class="h-2 rounded-full bg-white"><div class="h-2 w-[32%] rounded-full bg-blue-500"></div></div>
        <div class="h-2 rounded-full bg-white"><div class="h-2 w-[58%] rounded-full bg-forest-600"></div></div>
        <div class="h-2 rounded-full bg-white"><div class="h-2 w-[42%] rounded-full bg-amber-700"></div></div>
      </div>
    </div>
  ) : slug === 'data-health-panel' ? (
    <div class="mt-8 rounded-lg bg-[#eef2ec] p-5">
      <div class="grid grid-cols-[1fr_auto] items-center gap-4">
        <div class="h-2 rounded-full bg-white"><div class="h-2 w-[71%] rounded-full bg-amber-600"></div></div>
        <span class="text-xs font-semibold text-amber-800">Needs attention</span>
      </div>
      <div class="mt-4 grid gap-2">
        <span class="h-2 w-[82%] rounded-full bg-forest-600"></span>
        <span class="h-2 w-[30%] rounded-full bg-red-500"></span>
        <span class="h-2 w-[94%] rounded-full bg-forest-600"></span>
      </div>
    </div>
  ) : slug === 'pipeline-health-monitor' ? (
    <div class="mt-8 rounded-lg bg-[#eef2ec] p-5">
      <div class="flex items-end gap-2">
        <span class="h-12 flex-1 rounded-t bg-forest-600"></span>
        <span class="h-8 flex-1 rounded-t bg-forest-500"></span>
        <span class="h-16 flex-1 rounded-t bg-amber-500"></span>
        <span class="h-9 flex-1 rounded-t bg-forest-600"></span>
        <span class="h-5 flex-1 rounded-t bg-red-500"></span>
      </div>
      <div class="mt-4 h-2 rounded-full bg-white"><div class="h-2 w-[75%] rounded-full bg-forest-600"></div></div>
    </div>
  ) : slug === 'llm-usage-monitor' ? (
    <div class="mt-8 rounded-lg bg-[#eef2ec] p-5">
      <div class="grid grid-cols-4 items-end gap-2">
        <span class="h-14 rounded-t bg-forest-700"></span>
        <span class="h-20 rounded-t bg-amber-600"></span>
        <span class="h-10 rounded-t bg-forest-500"></span>
        <span class="h-16 rounded-t bg-slate-400"></span>
      </div>
      <div class="mt-4 grid grid-cols-3 gap-2">
        <span class="h-2 rounded-full bg-forest-700"></span>
        <span class="h-2 rounded-full bg-amber-600"></span>
        <span class="h-2 rounded-full bg-slate-400"></span>
      </div>
    </div>
  ) : (
    <div class="mt-8 rounded-lg bg-[#eef2ec] p-5">
      <svg class="h-24 w-full" viewBox="0 0 320 96" role="img" aria-label="Route preview">
        <path d="M32 57h69l42-24 54 30 91-34" fill="none" stroke="#b7c6b6" stroke-width="6" stroke-linecap="round"/>
        <path d="M32 57h69l42-24" fill="none" stroke="#4f8f2f" stroke-width="4" stroke-linecap="round"/>
        <path d="M143 33l54 30" fill="none" stroke="#4f8f2f" stroke-width="4" stroke-linecap="round" stroke-dasharray="8 10"/>
        <circle cx="32" cy="57" r="11" fill="#4f8f2f"/>
        <circle cx="143" cy="33" r="11" fill="#4f8f2f"/>
        <circle cx="288" cy="29" r="11" fill="#a9472d"/>
      </svg>
    </div>
  )}
</aside>
